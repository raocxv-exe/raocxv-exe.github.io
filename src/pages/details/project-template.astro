---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Header from "../../components/Header.astro";
import Sidebar from "../../components/Sidebar.astro";
import FloatingControls from "../../components/FloatingControls.astro";
import SpotlightCarousel from "../../components/SpotlightCarousel.astro";

import imgPlaceholder from "../../assets/projects/placeholder-big.png";

const templateScreenshots = [
  { src: imgPlaceholder, alt: "Slide 1" },
  { src: imgPlaceholder, alt: "Slide 2" },
  { src: imgPlaceholder, alt: "Slide 3" },
  { src: imgPlaceholder, alt: "Slide 4" },
];
---

<!doctype html>
<html>
  <Header title="Project Name | Project Details" />
  <body>
    <FloatingControls />
    <div class="content">
      <Sidebar selectedItem="proyectos" />
      <nav class="main">
        <div class="container">
          <!-- Back Button -->
          <div class="back-nav-container">
            <a href="/proyectos" class="back-nav-button w-inline-block">
              <Icon name="lucide:chevron-left" class="back-nav-img" />
              <div data-i18n="details.back">Volver a Proyectos</div>
            </a>
          </div>

          <div class="content-container" style="width: 100%;">
            <!-- Header -->
            <header class="project-header">
              <h1 class="project-title" style="margin-bottom: 8px;">Nombre del Proyecto</h1>
              <p class="lead" style="margin-bottom: 32px;">
                Una breve descripción de una línea que resume el propósito principal del proyecto y el valor que aporta.
              </p>
            </header>

            <div class="feature-graphic-wrapper">
              <Image
                src={imgPlaceholder}
                alt="Feature Graphic"
                class="feature-graphic-img"
                loading="eager"
              />
              <div class="feature-hint">
                <Icon name="lucide:zoom-in" size={14} />
                <span data-i18n="details.expand">Ampliar</span>
              </div>
            </div>

            <SpotlightCarousel items={templateScreenshots} />

            <!-- Info Grid -->
            <div class="info-grid">
              <div class="info-card">
                <div class="info-label">
                  <Icon name="lucide:target" size={18} />
                  <span data-i18n="details.asked">¿Qué se pidió?</span>
                </div>
                <p data-i18n="details.placeholder.asked">
                  Descripción del requerimiento inicial del cliente o el problema que se buscaba resolver con este desarrollo.
                </p>
              </div>

              <div class="info-card">
                <div class="info-label">
                  <Icon name="lucide:user" size={18} />
                  <span data-i18n="details.done">¿Qué hice?</span>
                </div>
                <p data-i18n="details.placeholder.done">
                  Detalles de mis responsabilidades, desde el diseño UI/UX hasta la implementación del backend o arquitectura.
                </p>
              </div>

              <div class="info-card">
                <div class="info-label">
                  <Icon name="lucide:cpu" size={18} />
                  <span data-i18n="details.tech">Tecnologías</span>
                </div>
                <div class="chips-container" style="margin-top: 12px;">
                  <div class="single-chip small-chip" style="display: flex; align-items: center; gap: 6px;">
                    <Icon name="lucide:rocket" size={12} />
                    <span>Astro</span>
                  </div>
                  <div class="single-chip small-chip" style="display: flex; align-items: center; gap: 6px;">
                    <Icon name="lucide:atom" size={12} />
                    <span>React</span>
                  </div>
                  <div class="single-chip small-chip" style="display: flex; align-items: center; gap: 6px;">
                    <Icon name="lucide:file-json" size={12} />
                    <span>TypeScript</span>
                  </div>
                  <div class="single-chip small-chip" style="display: flex; align-items: center; gap: 6px;">
                    <Icon name="lucide:server" size={12} />
                    <span>Node.js</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Detailed Sections -->
            <section class="details-section">
              <div class="section-title" data-i18n="details.analysis">Análisis y Desarrollo</div>
              <div class="project-desc">
                <p data-i18n="details.placeholder.analysis">
                  Aquí va una explicación más profunda del proceso. Cómo se abordó el problema, los desafíos técnicos encontrados y las decisiones de diseño tomadas durante el ciclo de vida del proyecto.
                </p>
              </div>
            </section>

            <section class="details-section">
              <div class="section-title" data-i18n="details.results">Resultados y Aprendizaje</div>
              <div class="project-desc">
                <p data-i18n="details.placeholder.results">
                  Impacto final del proyecto. Logros alcanzados, feedback del cliente o métricas de éxito (si aplican), y qué nuevos conocimientos se adquirieron tras finalizarlo.
                </p>
              </div>
            </section>

          </div>
        </div>
      </nav>
    </div>

    <!-- Lightbox Modal -->
    <div id="image-modal" class="image-modal">
      <span class="close-modal">&times;</span>
      <img src="" alt="Zoomed view" class="image-modal-content" />
    </div>

    <!-- Page Interaction Scripts -->
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const modal = document.getElementById("image-modal");
        const modalImg = modal?.querySelector(".image-modal-content");
        const closeBtn = modal?.querySelector(".close-modal");

        if (!modal || !modalImg || !closeBtn) return;

        const openModal = (src, alt) => {
          modal.style.display = "flex";
          document.body.classList.add("modal-open");
          setTimeout(() => modal.classList.add("show"), 10);
          modalImg.src = src;
          modalImg.alt = alt;
        };

        const fg = document.querySelector(".feature-graphic-img");
        fg?.addEventListener("click", () => {
          openModal(fg.src, fg.alt);
        });

        const closeModal = () => {
          modal.classList.remove("show");
          setTimeout(() => {
            modal.style.display = "none";
            document.body.classList.remove("modal-open");
          }, 300);
        };

        closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && modal.classList.contains("show")) closeModal();
        });
      });
    </script>

    <style>
      .project-header {
        text-align: center;
        animation: fadeIn 0.8s ease-out;
      }

      .project-header .lead {
        margin: 0 auto 16px;
        max-width: 800px;
        color: #a8a8a8;
      }

      /* Info Grid & Sections */
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 64px;
      }

      .info-card {
        background: rgba(43, 43, 43, 0.4);
        border: 1px solid #353535;
        border-radius: 12px;
        padding: 24px;
        transition: all 0.3s ease;
      }

      .info-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #fff;
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .info-card p, .project-desc p {
        color: #a8a8a8;
        font-size: 15px;
        line-height: 1.6;
      }

      .section-title {
        font-size: 24px;
        margin-bottom: 24px;
        color: #fff;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .feature-graphic-wrapper {
        position: relative;
        width: 100%;
        max-width: 900px;
        margin: 0 auto 36px;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #353535;
        background: #0d0d0d;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .feature-graphic-wrapper:hover {
        transform: scale(1.01);
        border-color: #555;
      }

      .feature-graphic-img {
        width: 100%;
        height: auto;
        display: block;
        user-select: none;
        -webkit-user-drag: none;
      }

      .feature-hint {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: rgba(10, 10, 10, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #eee;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 6px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .feature-graphic-wrapper:hover .feature-hint {
        opacity: 1;
      }

      /* Light Mode Variations */
      :global(html.light-mode) .feature-graphic-wrapper {
        background: #f5f5f5;
        border-color: #ddd;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
      }

      :global(html.light-mode) .feature-hint {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(0, 0, 0, 0.12);
        color: #222;
      }

      :global(html.light-mode) .info-card {
        background: #fff;
        border-color: #eee;
      }
      :global(html.light-mode) .info-label, :global(html.light-mode) .section-title {
        color: #111;
      }
      :global(html.light-mode) .info-card p, :global(html.light-mode) .project-desc p {
        color: #666;
      }
    </style>
  </body>
</html>
