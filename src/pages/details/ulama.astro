---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Header from "../../components/Header.astro";
import Sidebar from "../../components/Sidebar.astro";
import FloatingControls from "../../components/FloatingControls.astro";
import SpotlightCarousel from "../../components/SpotlightCarousel.astro";
import imgFg from "../../assets/projects/ulama/featureGraphic.png";
import imgFg2 from "../../assets/projects/ulama/featureGraphic_2.png";
import img1 from "../../assets/projects/ulama/1.jpg";
import img2 from "../../assets/projects/ulama/2.jpg";
import img3 from "../../assets/projects/ulama/3.jpg";
import img4 from "../../assets/projects/ulama/4.jpg";

const ulamaScreenshots = [
  { src: img1, alt: "Match schedule screen" },
  { src: img2, alt: "Group standings" },
  { src: img3, alt: "Match predictions" },
  { src: img4, alt: "Favorites screen" },
];
---

<!doctype html>
<html>
  <Header title="Ulama | Project Details" />
  <body>
    <FloatingControls />
    <div class="content">
      <Sidebar selectedItem="proyectos" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/proyectos" class="back-nav-button w-inline-block">
              <Icon name="lucide:chevron-left" class="back-nav-img" />
              <div data-i18n="details.back">Volver a Proyectos</div>
            </a>
          </div>

          <div class="content-container" style="width: 100%;">
            <header class="project-header">
              <h1
                class="project-title"
                style="margin-bottom: 8px;"
                data-i18n="details.ulama.title"
              >
                Ulama - Mundial 2026
              </h1>
              <p
                class="lead"
                style="margin-bottom: 16px;"
                data-i18n="details.ulama.lead"
              >
                App Android nativa para seguir el Mundial de Fútbol 2026:
                calendario de partidos, resultados en vivo, tabla de grupos y
                quiniela.
              </p>
              <a
                href="https://github.com/Ixeken-Studios/ulama-app"
                target="_blank"
                rel="noopener noreferrer"
                class="source-link"
              >
                <Icon name="lucide:github" size={16} />
                <span data-i18n="details.sourceCode">Project Source Code</span>
                <Icon name="lucide:external-link" size={14} />
              </a>
            </header>

            <div class="feature-graphics-container">
              <div class="feature-graphic-wrapper">
                <Image
                  src={imgFg}
                  alt="Ulama Feature Graphic"
                  class="feature-graphic-img"
                  loading="eager"
                />
                <div class="feature-hint">
                  <Icon name="lucide:zoom-in" size={14} />
                  <span data-i18n="details.expand">Ampliar</span>
                </div>
              </div>

              <div class="feature-graphic-wrapper">
                <Image
                  src={imgFg2}
                  alt="Ulama Feature Graphic 2"
                  class="feature-graphic-img"
                  loading="eager"
                />
                <div class="feature-hint">
                  <Icon name="lucide:zoom-in" size={14} />
                  <span data-i18n="details.expand">Ampliar</span>
                </div>
              </div>
            </div>

            <SpotlightCarousel items={ulamaScreenshots} />

            <div class="info-grid">
              <div class="info-card">
                <div class="info-label">
                  <Icon name="lucide:target" size={18} />
                  <span data-i18n="details.asked">¿Qué se pidió?</span>
                </div>
                <p data-i18n="details.ulama.asked">
                  Se solicitó una aplicación Android que permitiera a los
                  aficionados seguir el Mundial 2026 de forma sencilla: consultar
                  el calendario completo, resultados en vivo, posiciones de
                  grupos y guardar predicciones de cada partido.
                </p>
              </div>

              <div class="info-card">
                <div class="info-label">
                  <Icon name="lucide:user" size={18} />
                  <span data-i18n="details.done">¿Qué hice?</span>
                </div>
                <p data-i18n="details.ulama.done">
                  Desarrollador Android. Diseñé e implementé la app completa
                  usando Kotlin y Jetpack Compose con Material 3. Arquitectura
                  limpia con Hilt, Room y Retrofit.
                </p>
              </div>

              <div class="info-card">
                <div class="info-label">
                  <Icon name="lucide:cpu" size={18} />
                  <span data-i18n="details.tech">Tecnologías</span>
                </div>
                <div class="chips-container" style="margin-top: 12px;">
                  <div
                    class="single-chip small-chip"
                    style="display: flex; align-items: center; gap: 6px;"
                  >
                    <Icon name="lucide:code-2" size={12} />
                    <span>Kotlin</span>
                  </div>
                  <div
                    class="single-chip small-chip"
                    style="display: flex; align-items: center; gap: 6px;"
                  >
                    <Icon name="lucide:layout" size={12} />
                    <span>Jetpack Compose</span>
                  </div>
                  <div
                    class="single-chip small-chip"
                    style="display: flex; align-items: center; gap: 6px;"
                  >
                    <Icon name="lucide:box" size={12} />
                    <span>Hilt</span>
                  </div>
                  <div
                    class="single-chip small-chip"
                    style="display: flex; align-items: center; gap: 6px;"
                  >
                    <Icon name="lucide:database" size={12} />
                    <span>Room</span>
                  </div>
                  <div
                    class="single-chip small-chip"
                    style="display: flex; align-items: center; gap: 6px;"
                  >
                    <Icon name="lucide:cloud" size={12} />
                    <span>Retrofit</span>
                  </div>
                  <div
                    class="single-chip small-chip"
                    style="display: flex; align-items: center; gap: 6px;"
                  >
                    <Icon name="lucide:smartphone" size={12} />
                    <span>Android</span>
                  </div>
                </div>
              </div>
            </div>

            <section class="details-section">
              <div class="section-title" data-i18n="details.analysis">
                Análisis y Desarrollo
              </div>
              <div class="project-desc">
                <p data-i18n="details.ulama.analysis.p1">
                  El mayor reto fue ofrecer una experiencia fluida con datos en
                  tiempo real. Se diseñó un flujo unidireccional de datos donde
                  el UI reacciona a cambios en los repositorios.
                </p>
                <p data-i18n="details.ulama.analysis.p2">
                  Se implementaron dos fuentes de datos: openfootball para el
                  calendario y ESPN para resultados en vivo. El usuario puede
                  activar notificaciones por partido y marcar equipos favoritos.
                </p>
              </div>
            </section>

            <section class="details-section">
              <div class="section-title" data-i18n="details.results">
                Resultados y Aprendizaje
              </div>
              <div class="project-desc">
                <p data-i18n="details.ulama.results.p1">
                  La app se publicó en GitHub bajo licencia MIT y está
                  disponible para dispositivos Android 14+.
                </p>
                <p data-i18n="details.ulama.results.p2">
                  Ulama demostró que es posible construir una app completa para
                  un evento global usando las mejores prácticas de Android
                  moderno.
                </p>
              </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <div id="image-modal" class="image-modal">
      <span class="close-modal">&times;</span>
      <img src="" alt="Zoomed view" class="image-modal-content" />
    </div>

    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const modal = document.getElementById("image-modal");
        const modalImg = modal?.querySelector(".image-modal-content");
        const closeBtn = modal?.querySelector(".close-modal");

        if (!modal || !modalImg || !closeBtn) return;

        const openModal = (src, alt) => {
          modal.style.display = "flex";
          document.body.classList.add("modal-open");
          setTimeout(() => modal.classList.add("show"), 10);
          modalImg.src = src;
          modalImg.alt = alt;
        };

        const fgs = document.querySelectorAll(".feature-graphic-img");
        fgs.forEach((fg) => {
          fg.addEventListener("click", () => {
            openModal(fg.src, fg.alt);
          });
        });

        const closeModal = () => {
          modal.classList.remove("show");
          setTimeout(() => {
            modal.style.display = "none";
            document.body.classList.remove("modal-open");
          }, 300);
        };

        closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && modal.classList.contains("show")) closeModal();
        });
      });
    </script>

    <style>
      .project-header {
        text-align: center;
        animation: fadeIn 0.8s ease-out;
      }

      .project-header .lead {
        margin: 0 auto 16px;
        max-width: 800px;
        color: #a8a8a8;
      }

      .source-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #a8a8a8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        padding: 6px 14px;
        border: 1px solid #353535;
        border-radius: 8px;
        transition: all 0.2s ease;
        margin-bottom: 32px;
      }
      .source-link:hover {
        border-color: #555;
        color: #fff;
        background: rgba(255, 255, 255, 0.05);
      }
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 64px;
      }

      .info-card {
        background: rgba(43, 43, 43, 0.4);
        border: 1px solid #353535;
        border-radius: 12px;
        padding: 24px;
        transition: all 0.3s ease;
      }

      .info-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #fff;
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .info-card p,
      .project-desc p {
        color: #a8a8a8;
        font-size: 15px;
        line-height: 1.6;
      }

      .section-title {
        font-size: 24px;
        margin-bottom: 24px;
        color: #fff;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .feature-graphics-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-bottom: 36px;
      }

      .feature-graphic-wrapper {
        position: relative;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #353535;
        background: #0d0d0d;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .feature-graphic-wrapper:hover {
        transform: scale(1.01);
        border-color: #555;
      }

      .feature-graphic-img {
        width: 100%;
        height: auto;
        display: block;
        user-select: none;
        -webkit-user-drag: none;
      }

      .feature-hint {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: rgba(10, 10, 10, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #eee;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 6px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .feature-graphic-wrapper:hover .feature-hint {
        opacity: 1;
      }

      :global(html.light-mode) .feature-graphic-wrapper {
        background: #f5f5f5;
        border-color: #ddd;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
      }

      :global(html.light-mode) .feature-hint {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(0, 0, 0, 0.12);
        color: #222;
      }

      :global(html.light-mode) .info-card {
        background: #fff;
        border-color: #eee;
      }
      :global(html.light-mode) .info-label,
      :global(html.light-mode) .section-title {
        color: #111;
      }
      :global(html.light-mode) .info-card p,
      :global(html.light-mode) .project-desc p {
        color: #666;
      }

      :global(html.light-mode) .source-link {
        border-color: #ddd;
        color: #666;
      }
      :global(html.light-mode) .source-link:hover {
        border-color: #bbb;
        color: #111;
        background: rgba(0, 0, 0, 0.03);
      }
    </style>
  </body>
</html>
